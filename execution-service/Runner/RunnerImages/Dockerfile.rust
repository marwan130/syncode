FROM rust:1.99.1-slim-bookworm

ENV RUNNER_RUNTIME=rust \
    TMPDIR=/runner/tmp \
    TMP=/runner/tmp \
    TEMP=/runner/tmp

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y build-essential \
    && rustup component add rust-analyzer rust-src \
    && rm -rf /var/lib/apt/lists/* \
    && /usr/sbin/groupadd --system --gid 10001 runner \
    && /usr/sbin/useradd --system --uid 10001 --gid runner --no-create-home --shell /usr/sbin/nologin runner \
    && mkdir -p /workspace \
    && chown runner:runner /workspace

COPY entrypoint.sh /usr/local/bin/runner-entrypoint
RUN chmod 0555 /usr/local/bin/runner-entrypoint

WORKDIR /workspace
USER 10001:10001

ENTRYPOINT ["/usr/local/bin/runner-entrypoint"]
